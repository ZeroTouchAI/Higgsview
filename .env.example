# Copy to .env.local (local) and add the same vars in Vercel → Project → Settings → Environment Variables.

# Google sign-in + Drive export: OAuth "Web application" client ID from console.cloud.google.com (see README).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Signs the login cookie. Any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Vercel Blob store (Vercel → Storage → Blob → connect to the project; this var is added for you).
BLOB_READ_WRITE_TOKEN=

# Optional. Vercel sets CRON_SECRET for the daily cleanup of old uploads if you add it; any random string.
CRON_SECRET=

# Optional: this Google account may use the server's own Kie key (everyone else pastes their own key in the app).
OWNER_EMAIL=
KIE_API_KEY=
