# Copy to .env.local (local) and add the same vars in Vercel → Project → Settings → Environment Variables.

# Required: one key unlocks every model (Seedance, Kling, Veo, Wan, Grok, Hailuo, Nano Banana). https://kie.ai/api-key
KIE_API_KEY=

# Login password for the deployed site. Leave empty locally to skip login.
APP_PASSWORD=
